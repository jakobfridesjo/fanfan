{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "App Template",
  "version": "../package.json",
  "identifier": "com.example.app-template",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "翻翻",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/cedict.txt.gz", "resources/voice/"]
  }
}
