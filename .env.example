# Copy to .env.local for local development (`mise env:init` does that for you).
# .env is reserved for build-time injection.
# NOTE: Do NOT commit sensitive values.

# HEADER BANNER
# Warning banner shown in the page header. Leave unset to hide it.
# VITE_HEADER_TEXT=PRODUCTION ENVIRONMENT ACTIVE
# Banner background as a quoted hex color (unquoted, # starts a comment); defaults to the warning color.
# VITE_HEADER_COLOR="#e11d48"
